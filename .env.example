# Copy to /etc/tea-talks/env on the server (never commit the real file).
# There is no ADMIN_PASSWORD here: the moderator passphrase is chosen through the
# one-time setup link (node scripts/setup-link.mjs) and stored as a hash in the database.

# Show the public stories page at /stories. "true" or "false".
PUBLIC_ARCHIVE=true

# Where the SQLite database lives. The directory must exist and be writable by the app user.
DB_PATH=/var/lib/tea-talks/tea-talks.sqlite

# Where the quick-exit button sends people. Pick a weather site that is ordinary in the region.
QUICK_EXIT_URL=https://www.weather.com/

# Optional. If set, the contact page shows this address under the form. Never a Gmail address.
# CONTACT_EMAIL=

# Preview mode for a temporary click-through only (see deploy/VERCEL-PREVIEW.md).
# "true" stores nothing at all and shows sample rows. Leave "false" on the real server.
DEMO_MODE=false

# Bind address and port. Keep it on localhost; Caddy is the only thing that should reach it.
HOST=127.0.0.1
PORT=4321
