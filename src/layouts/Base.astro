---
/**
 * Page shell for every screen: header with the plain-text wordmark, the quick exit
 * in its fixed corner, and a main column. The <title> is always just the site name,
 * so a tab or history entry says nothing more than that.
 * No inline styles, no inline scripts (the Content-Security-Policy forbids them).
 */
import '../styles/global.css';
import { copy } from '../copy';
import { config } from '../lib/config';
import QuickExit from '../components/QuickExit.astro';

interface Props {
  /** Show the "Team" chip next to the wordmark (moderation screens). */
  team?: boolean;
  /** Use the wider 760px column (moderation list). */
  wide?: boolean;
}
const { team = false, wide = false } = Astro.props;
---
<!doctype html>
<html lang={copy.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={copy.siteDescription} />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{copy.siteName}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="header">
      <a class="wordmark" href="/" data-replace>{copy.siteName}</a>
      {team && <span class="chip">{copy.admin.chip}</span>}
    </header>
    <QuickExit />
    {config.demoMode && <p class="demo-banner" role="note">{copy.demo.banner}</p>}
    <main class:list={['page', { 'page-wide': wide }]}>
      <slot />
    </main>
    <script is:inline src="/quick-exit.js" defer></script>
  </body>
</html>
