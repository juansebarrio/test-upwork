---
/**
 * Page shell for every screen: skip link, header (brand, navigation, language
 * slot, quick-exit pill), main column, footer. The header and footer markup
 * comes from src/lib/shell.ts so the middleware's bare error pages carry the
 * identical shell. No inline styles, no inline scripts (the CSP forbids them).
 */
import { copy } from '../content/copy';
import { footerHtml, headerHtml } from '../lib/shell';

interface Props {
  title: string;
  /** Tea Talks routes: <meta name="robots" content="noindex, nofollow">. */
  noindex?: boolean;
  /** Use the wider 760px column (stories list, moderation panel). */
  wide?: boolean;
  /** Tea Talks pages: internal links navigate with location.replace. */
  replaceLinks?: boolean;
  /** href of the current nav item, if any. */
  current?: string;
}
const { title, noindex = false, wide = false, replaceLinks = false, current } = Astro.props;
const fullTitle = title === copy.siteName ? title : `${title} · ${copy.siteName}`;
---
<!doctype html>
<html lang={copy.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={copy.siteDescription} />
    <meta name="referrer" content="no-referrer" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{fullTitle}</title>
    <link rel="stylesheet" href="/site.css" />
  </head>
  <body>
    <Fragment set:html={headerHtml({ replaceLinks, current })} />
    <main id="main" class:list={['page', { 'page-wide': wide }]} tabindex="-1">
      <slot />
    </main>
    <Fragment set:html={footerHtml({ replaceLinks })} />
    <script is:inline src="/quick-exit.js" defer></script>
  </body>
</html>
