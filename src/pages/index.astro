---
import Base from '../layouts/Base.astro';
import Cup from '../components/Cup.astro';
import { copy } from '../copy';
import { config } from '../lib/config';

// A validation hint may come back from /submit as ?e=empty or ?e=long.
// Nothing the visitor wrote is ever part of a URL or echoed here.
const e = Astro.url.searchParams.get('e');
const error = e === 'empty' ? copy.home.errors.empty : e === 'long' ? copy.home.errors.long : null;
---
<Base title={copy.home.title}>
  <section class="hero">
    <Cup class="cup" />
    <h1>{copy.home.greeting}</h1>
    {copy.home.intro.map((p) => <p class="lead">{p}</p>)}
  </section>

  <section class="card">
    {error && <p class="notice" role="alert">{error}</p>}
    <form method="post" action="/submit" data-replace-submit autocomplete="off">
      <label for="story">{copy.home.textareaLabel}</label>
      <p class="hint hint-above">{copy.home.reminder}</p>
      <textarea
        id="story"
        name="story"
        required
        maxlength={config.maxLength}
        placeholder={copy.home.placeholder}
        autocomplete="off"
        spellcheck="false"
      ></textarea>

      <!--
        Honeypot. Hidden from people; simple bots fill every field.
        The name is deliberately meaningless so browser autofill (which guesses
        from names like "website", "email", "name") never touches it. If it
        did, real stories would be dropped as spam.
      -->
      <div class="hp" aria-hidden="true">
        <label for="x9f3a">Leave this empty</label>
        <input type="text" id="x9f3a" name="x9f3a" tabindex="-1" autocomplete="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" data-bwignore="true" />
      </div>

      <button type="submit" class="btn btn-wide">{copy.home.submit}</button>
      <p class="hint">{copy.home.afterSubmitNote}</p>
    </form>
  </section>

  <p class="quick-exit-hint">{copy.quickExit.hint}</p>
</Base>
