---
import Base from '../layouts/Base.astro';
import { copy } from '../content/copy';
import { home } from '../content/pages';
import { ARROW_ICON } from '../lib/shell';
---
<Base title={copy.siteName} current="/">
  <h1 class="sr-only">{copy.siteName}</h1>
  <div class="home">
    <section class="home-vignettes" aria-label="Opening">
      {home.vignettes.map((v) => <p class="vignette">{v}</p>)}
    </section>

    <section class="home-welcome" aria-label="Welcome">
      {home.welcome.map((p) => <p class="body">{p}</p>)}
    </section>

    <!-- The same block is a paper card on phones (after the vignettes) and a full-width band on desktop (after the welcome). -->
    <section class="home-tea shape s-tint" aria-labelledby="tea-heading">
      <div class="band shape s-disc-right">
        <h2 id="tea-heading">{home.teaTalks.heading}</h2>
        {home.teaTalks.body.map((p) => <p class="body">{p}</p>)}
        <div class="actions">
          <a class="btn-primary" href="/tea-talks">{home.teaTalks.share}</a>
          <a class="btn-secondary" href="/stories">{home.teaTalks.read}</a>
        </div>
      </div>
    </section>

    <section class="home-held shape s-ring-side" aria-label="A welcome">
      <p class="held">{home.held}</p>
    </section>

    <nav class="home-doors shape s-ring" aria-label="More">
      <ul class="doors">
        {home.doors.map((d) => (
          <li><a href={d.href}><span>{d.label}</span><Fragment set:html={ARROW_ICON} /></a></li>
        ))}
      </ul>
    </nav>
  </div>
</Base>
