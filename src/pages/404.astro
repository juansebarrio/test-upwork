---
import Base from '../layouts/Base.astro';
import { copy } from '../content/copy';
---
<Base title={copy.notFound.heading} noindex>
  <section class="centered">
    <h1>{copy.notFound.heading}</h1>
    <p class="body">{copy.notFound.body}</p>
    <p class="return"><a class="link" href="/">{copy.notFound.back}</a></p>
  </section>
</Base>
