---
import Base from '../layouts/Base.astro';
import { copy } from '../content/copy';
import { about } from '../content/pages';
---
<Base title={copy.titles.about} current="/about">
  <h1 class="sr-only">{copy.titles.about}</h1>
  <section class="section shape s-disc-left">
    <h2>{about.nameHeading}</h2>
    <div class="stack">{about.name.map((p) => <p class="body">{p}</p>)}</div>
  </section>
  <section class="section">
    <h2>{about.believeHeading}</h2>
    <ul class="rows">{about.believe.map((line) => <li>{line}</li>)}</ul>
  </section>
  <section class="section shape s-ring-after">
    <h2>{about.elseHeading}</h2>
    <div class="stack">{about.else.map((p) => <p class="body">{p}</p>)}</div>
  </section>
</Base>
